# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Or, for your own use only: answer with a local Anthropic-compatible server instead
# (e.g. claude-api on your Pro/Max plan). Keep TRIP_CODE secret, since the backend is public.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# Passcode the chat asks for once per device. Required. Never put it on GitHub.
TRIP_CODE=change-me

# Pages allowed to call this backend (comma separated). Your GitHub Pages origin, plus local testing.
ALLOWED_ORIGINS=https://xiao215.github.io,http://localhost:8000,http://127.0.0.1:8000

MODEL=claude-opus-5-5
EFFORT=low
PORT=8790

# Abuse guards
PER_IP_PER_10MIN=20
DAILY_LIMIT=300
