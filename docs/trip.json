 "prep": [
  {
   "title": "Pack",
   "items": [
    {
     "t": "Warm non-cotton layers, a rain or wind shell, hat and light gloves",
     "more": "Mid-October mornings in Muskoka and Algonquin can be near freezing, and it's colder on the water. Check the forecast above each day."
    },
    {
     "t": "Shoes that can get wet, plus hiking shoes",
     "more": "You may step into the shallows launching the canoe. Fall trails get muddy, especially the Arrowhead Lake loop."
    },
    {
     "t": "Dry bag or zip bags for phones and keys"
    },
    {
     "t": "A full change of dry clothes, left in the car",
     "more": "For after the paddle, before the drive home."
    },
    {
     "t": "Picnic lunches, water and snacks",
     "more": "Saturday's lunch is a picnic at Arrowhead Lake; Sunday's is at Ragged Falls. Grab both in Huntsville."
    },
    {
     "t": "Phone charger and power bank"
    },
    {
     "t": "Small first-aid kit, sunscreen, bug spray"
    }
   ]
  },
  {
   "title": "Before you drive",
   "items": [
    {
     "t": "Check the permit confirmation emails (plate number right?)",
     "more": "If the car changed, update the plate under Preregister in your Ontario Parks account, or call 1-888-668-7275."
    },
    {
     "t": "Download offline Google Maps for Huntsville to Algonquin",
     "more": "Cell service drops out inside the park."
    },
    {
     "t": "Check the colour report the Thursday before",
     "more": "[ontarioparks.ca/fallcolour](https://www.ontarioparks.ca/fallcolour)"
    },
    {
     "t": "Fill up in Huntsville or Dwight",
     "more": "There's no gas inside Algonquin."
    }
   ]
  },
  {
   "title": "On the road",
   "items": [
    {
     "t": "Park only in marked lots",
     "more": "Stopping on the Hwy 60 shoulder can get you towed. If the Lookout Trail lot is full, park at Big Pines (km 40.3) and take the 450 m connector."
    },
    {
     "t": "Watch for moose and deer at dusk",
     "more": "Especially on the drive out of the park and on Hwy 60 after sunset."
    },
    {
     "t": "Leave buffer for holiday traffic",
     "more": "Holiday traffic on the 400 can add 30–60 minutes each way."
    }
   ]
  }
 ],
